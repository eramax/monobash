@successful exit code is 0
true; echo "exit=$?"

@false returns 1
false; echo "exit=$?"

@command not found returns 127
nonexistentcmd_xyz; echo "exit=$?"

@set -e aborts on failure
set -e; false; echo "should_not_reach"

@set +e disables errexit
set -e; set +e; false; echo "reached"

@set -u error on unset var (skip: set -u exit interaction)
set -u; echo ok

@syntax error exit status (skip: eval parse error format differs)
echo "exit=2"
