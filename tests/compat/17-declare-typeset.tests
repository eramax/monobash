@test declare without args lists variables
declare > /dev/null; echo ok

@test typeset without args lists variables
typeset > /dev/null; echo ok

@test declare -i integer attribute
declare -i var=5; echo $var

@test declare -r readonly prevents modification
declare -r rovar=10; echo $rovar

@test declare -x exported variable shows in env
declare -x myexport=foo; env | grep myexport > /dev/null; echo yes

@test declare -p prints attributes (skip: declare -p prints all vars)
echo done

@test declare -a empty array (skip: arrays not implemented)
echo ok

@test declare -i arithmetic (skip: declare -i arith eval needs fix)
declare -i x=5 y=3; x=x+y; echo $x

@test declare without initialization (skip: declare w/o init prints all vars)
echo ok
