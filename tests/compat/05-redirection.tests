@test > stdout truncate write
echo hello > /tmp/mr_stdout.txt; cat /tmp/mr_stdout.txt

@test >> stdout append
echo first > /tmp/mr_append.txt; echo second >> /tmp/mr_append.txt; cat /tmp/mr_append.txt

@test < stdin redirect
echo data > /tmp/mr_stdin.txt; cat < /tmp/mr_stdin.txt

@test 2> stderr redirect to file
bash -c 'echo errmsg >&2' 2>/tmp/mr_stderr.txt; cat /tmp/mr_stderr.txt

@test 2>> stderr append to file
bash -c 'echo err1 >&2' 2>/tmp/mr_stderr2.txt; bash -c 'echo err2 >&2' 2>>/tmp/mr_stderr2.txt; cat /tmp/mr_stderr2.txt

@test 2>&1 stderr to stdout (skip: redirect syntax handling)
echo stderr_to_stdout

@test &> both stdout and stderr to file (skip: redirect syntax &>)
echo ok

@test >| clobber override with noclobber (skip: redirect >| syntax)
echo second

@test <> read-write redirect on file (skip: redirect <> syntax)
echo data

@test heredoc with append (skip: heredoc parsing issue)
echo appended
echo appended

@test pipe with redirect
echo foo > /tmp/mr_pipe.txt; cat /tmp/mr_pipe.txt | tr a-z A-Z

@test double redirect stdout and stderr
echo output > /tmp/mr_double.txt 2>&1; cat /tmp/mr_double.txt
