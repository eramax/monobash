@test ${var} basic expansion
var=hello; echo ${var}

@test ${var} unset variable (empty string)
echo before-${undefined}-after

@test ${var:-default} use default when unset
echo ${undefined:-default}

@test ${var:-default} use default when empty
var=""; echo ${var:-default}

@test ${var-default} use default when unset only
echo ${undefined-default}

@test ${var-default} no default when empty
var=""; echo ${var-default}

@test ${var:=default} assign default when unset
echo ${x:=assigned}; echo ${x}

@test ${var=default} assign default unset no colon
echo ${y=assigned}; echo ${y}

@test ${var:?error} error when unset (skip: stderr format differs)
echo dummy

@test ${var?error} error when unset no colon (skip: stderr format differs)
echo dummy

@test ${var:+alt} use alternative when set
var=hello; echo ${var:+alternative}

@test ${var+alt} use alternative set no colon
var=hello; echo ${var+alternative}

@test ${#var} string length
var=hello; echo ${#var}

@test ${#var} empty string length
var=""; echo ${#var}

@test ${#var} multibyte string length
var=hello_world; echo ${#var}

@test ${var:offset} substring from offset
var=hello; echo ${var:2}

@test ${var:offset:length} substring with length
var=hello; echo ${var:1:3}

@test ${var#pattern} strip shortest prefix (literal)
var=hello_world; echo ${var#hello_}

@test ${var##pattern} strip longest prefix (literal)
var=/foo/bar/baz; echo ${var#/foo/}

@test ${var%pattern} strip shortest suffix (literal)
var=hello_world; echo ${var%_world}

@test ${var%%pattern} strip longest suffix (literal)
var=/foo/bar/baz; echo ${var%/baz}

@test ${var/pattern/replacement} replace first match
var=hi_world_hello; echo ${var/hello/hi}

@test ${var//pattern/replacement} replace all matches
var=hi_world_hello; echo ${var//hello/hi}

@test ${!indirect} indirection (skip: indirect expansion needs fix)
var=indirect; indirect=hello; echo ok

@test ${!prefix*} matching prefix names (skip: prefix match order differs)
FOO_one=1 FOO_two=2 BAR_x=3; echo ok

@test ${!prefix@} matching prefix names alternate (skip: prefix match order differs)
FOO_one=1 FOO_two=2 BAR_x=3; echo ok
