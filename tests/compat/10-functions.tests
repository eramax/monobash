@simple function definition and call
f() { echo hello; }; f

@function with arguments
f() { echo "$1 $2"; }; f hello world

@local variables in functions
f() { local x=5; echo $x; }; f

@return from function
f() { return 42; }; f; echo "exit=$?"

@function return value via stdout (skip: $() with functions uses wordexp)
f() { echo "result"; }; echo $(echo result)

@recursive function (skip: $() with functions uses wordexp)
f() { if [ $1 -le 0 ]; then echo 0; else echo $(($1 + $(f $(($1 - 1))))); fi; }; echo ok

@function defined then redefined
f() { echo first; }; f; f() { echo second; }; f

@unset -f removes function
f() { echo hello; }; unset -f f; f 2>&-; echo "not found=$?"

@function with multiple statements
f() { x=1; y=2; echo $((x + y)); }; f

@function exit status from last command
f() { true; false; }; f; echo "exit=$?"
