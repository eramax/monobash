@test star matches anything
x=foobar; case $x in foo*) echo yes;; esac

@test question mark matches single char
case b in ?) echo yes;; esac

@test bracket expression positive
case b in [abc]) echo yes;; esac

@test negated bracket expression
case a in [!abc]) echo no;; *) echo yes;; esac

@test bracket range
case c in [a-z]) echo yes;; esac

@test multiple patterns with pipe
case x in a|b|x) echo yes;; esac

@test default star case
case z in a) echo no;; *) echo yes;; esac

@test pattern with alternation default
case y in a|b) echo no;; *) echo yes;; esac

@test set -f disables glob expansion (skip: wordpexp glob expansion)
echo "*"

@test extended glob ?(pattern) (skip: extended glob not supported)
echo no

@test extended glob +(pattern) (skip: extended glob not supported)
echo no

@test pattern matching with literal dot
case file.txt in *.txt) echo yes;; esac
