@test simple indexed array
a=(1 2 3); echo ${a[0]} ${a[1]} ${a[2]}

@test ${a[@]} all elements
a=(1 2 3); echo ${a[@]}

@test ${a[*]} all elements
a=(1 2 3); echo ${a[*]}

@test ${#a[@]} array length
a=(1 2 3); echo ${#a[@]}

@test ${#a[0]} element string length
a=(hello foo bar); echo ${#a[0]}

@test a+=(4 5) append to array
a=(1 2 3); a+=(4 5); echo ${a[@]}

@test declare -a explicit indexed array
declare -a a=(1 2 3); echo ${a[1]}

@test declare -A associative array
declare -A aa=([x]=1 [y]=2); echo ${aa[x]} ${aa[y]}

@test ${!aa[@]} associative array keys
declare -A aa=([x]=1 [y]=2); echo ${!aa[@]}

@test ${#aa[@]} associative array length
declare -A aa=([x]=1 [y]=2); echo ${#aa[@]}

@test ${aa[@]} all associative values
declare -A aa=([x]=1 [y]=2); echo ${aa[@]}

@test array slice ${a[@]:offset:length}
a=(a b c d e); echo ${a[@]:1:3}

@test unset array element
a=(1 2 3); unset a[1]; echo ${a[@]}

@test read -a array from herestring
read -a arr <<< "a b c"; echo ${arr[1]}

@test array elements with spaces
a=("hello world" foo); echo "${a[0]}"

@test ${!a[@]} indexed array keys
a=(10 20 30); echo ${!a[@]}

@test reassign array element
a=(1 2 3); a[1]=99; echo ${a[@]}

@test empty array length
a=(); echo ${#a[@]}

@test single element array
a=(42); echo ${a[0]}

@test array from command substitution words
a=($(echo 1 2 3)); echo ${a[@]}
