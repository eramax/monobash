@test basic comma brace expansion
echo {a,b,c}

@test numeric range
echo {1..5}

@test letter range
echo {a..e}

@test mixed brace expansion with prefix
echo pre-{a,b}-post

@test nested brace expansion
echo {a,b{c,d}}

@test brace expansion with prefix and mkdir
mkdir -p /tmp/dir{a,b} 2>/dev/null; ls /tmp/dir* 2>/dev/null; rm -rf /tmp/dira /tmp/dirb

@test empty elements in brace expansion
echo {a,,c}

@test brace expansion with multiple prefixes
echo /tmp/{a,b}/file

@test brace expansion with dots in prefix
echo {a..c}.txt

@test combined comma and range
echo {a,b,1..3}
